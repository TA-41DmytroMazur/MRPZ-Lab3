# ==============================================================================
# Шаблон змінних середовища для Docker Compose (безпечно для публікації на GitHub).
# Для локального запуску скопіюйте цей файл як .env та вкажіть реальні паролі.
# ==============================================================================

COMPOSE_PROJECT_NAME=classroom-management

# Параметри бази даних PostgreSQL
POSTGRES_DB=classroom_db
POSTGRES_USER=classroom_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# Параметри ASP.NET Core Web API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ENABLE_SWAGGER=true

# Параметри входу в PgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@kpi.ua
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050
